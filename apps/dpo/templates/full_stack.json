{
  "name": "full-stack-app",
  "category": "full-stack",
  "description": "Complete full-stack application with frontend, backend, and database",
  "version": "1.0.0",
  "technologies": ["react", "typescript", "nodejs", "express", "postgresql", "redis"],
  "quality_gates": {
    "code_coverage": 75,
    "performance_threshold": 300,
    "security_scan": true,
    "documentation_required": true,
    "accessibility_score": 90
  },
  "workflow": {
    "phases": [
      {
        "name": "requirements_gathering",
        "agents": ["requirements_analyst", "ux_designer"],
        "duration_estimate": "1h",
        "deliverables": ["requirements.md", "user_stories.md", "wireframes/"]
      },
      {
        "name": "system_design",
        "agents": ["system_architect", "database_designer", "frontend_architect"],
        "duration_estimate": "1.5h",
        "deliverables": ["architecture.md", "database_design.md", "component_design.md"]
      },
      {
        "name": "backend_development",
        "agents": ["backend_developer", "api_specialist"],
        "duration_estimate": "3h",
        "parallel": true,
        "deliverables": ["backend/src/", "backend/tests/"]
      },
      {
        "name": "frontend_development",
        "agents": ["frontend_developer", "ui_specialist"],
        "duration_estimate": "3h",
        "parallel": true,
        "deliverables": ["frontend/src/", "frontend/tests/"]
      },
      {
        "name": "database_setup",
        "agents": ["database_developer"],
        "duration_estimate": "1h",
        "deliverables": ["database/migrations/", "database/seeds/"]
      },
      {
        "name": "integration",
        "agents": ["integration_specialist", "backend_developer", "frontend_developer"],
        "duration_estimate": "2h",
        "deliverables": ["integration_tests/", "api_client/"]
      },
      {
        "name": "testing",
        "agents": ["test_engineer", "qa_specialist", "performance_tester"],
        "duration_estimate": "2h",
        "deliverables": ["test_reports/", "performance_report.md"]
      },
      {
        "name": "ui_ux_polish",
        "agents": ["ux_designer", "frontend_developer"],
        "duration_estimate": "1h",
        "deliverables": ["frontend/src/styles/", "frontend/src/components/"]
      },
      {
        "name": "documentation",
        "agents": ["technical_writer"],
        "duration_estimate": "1h",
        "deliverables": ["docs/", "README.md", "CONTRIBUTING.md"]
      },
      {
        "name": "deployment",
        "agents": ["devops_engineer", "cloud_specialist"],
        "duration_estimate": "1h",
        "deliverables": ["docker/", "kubernetes/", ".github/workflows/"]
      }
    ]
  },
  "structure": {
    "directories": [
      "frontend/src/components",
      "frontend/src/pages",
      "frontend/src/services",
      "frontend/src/hooks",
      "frontend/src/utils",
      "frontend/src/styles",
      "frontend/tests",
      "backend/src/controllers",
      "backend/src/models",
      "backend/src/services",
      "backend/src/middleware",
      "backend/src/utils",
      "backend/tests",
      "database/migrations",
      "database/seeds",
      "integration_tests",
      "docs",
      "docker",
      "kubernetes"
    ],
    "files": [
      "frontend/package.json",
      "frontend/tsconfig.json",
      "frontend/.env.example",
      "backend/package.json",
      "backend/tsconfig.json",
      "backend/.env.example",
      "docker-compose.yml",
      "Makefile",
      "README.md",
      ".gitignore"
    ]
  },
  "dependencies": {
    "frontend": {
      "core": [
        "react@^18.0.0",
        "react-dom@^18.0.0",
        "react-router-dom@^6.0.0",
        "axios@^1.0.0",
        "typescript@^5.0.0"
      ],
      "dev": [
        "@types/react@^18.0.0",
        "@testing-library/react@^14.0.0",
        "jest@^29.0.0",
        "vite@^4.0.0"
      ]
    },
    "backend": {
      "core": [
        "express@^4.18.0",
        "cors@^2.8.5",
        "helmet@^7.0.0",
        "pg@^8.11.0",
        "redis@^4.6.0",
        "jsonwebtoken@^9.0.0"
      ],
      "dev": [
        "@types/express@^4.17.0",
        "jest@^29.0.0",
        "supertest@^6.3.0",
        "nodemon@^3.0.0"
      ]
    }
  },
  "configuration": {
    "environment_variables": [
      "NODE_ENV",
      "DATABASE_URL",
      "REDIS_URL",
      "JWT_SECRET",
      "API_URL",
      "FRONTEND_URL",
      "PORT"
    ],
    "config_files": [
      "frontend/.env.development",
      "frontend/.env.production",
      "backend/.env.development",
      "backend/.env.production"
    ]
  },
  "quality_checks": [
    {
      "name": "frontend_lint",
      "command": "cd frontend && npm run lint",
      "threshold": 0
    },
    {
      "name": "backend_lint",
      "command": "cd backend && npm run lint",
      "threshold": 0
    },
    {
      "name": "frontend_test",
      "command": "cd frontend && npm test -- --coverage",
      "threshold": 75
    },
    {
      "name": "backend_test",
      "command": "cd backend && npm test -- --coverage",
      "threshold": 80
    },
    {
      "name": "e2e_test",
      "command": "npm run test:e2e",
      "threshold": 100
    }
  ]
}
