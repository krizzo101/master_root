# Project Context Production Environment Configuration
# Copy this file to .env and configure the values

# =============================================================================
# Database Configuration
# =============================================================================
DB_NAME=unified_context
DB_USER=opsvi
DB_PASSWORD=your_secure_db_password_here
DB_HOST=postgres
DB_PORT=5432

# Database connection pool settings
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=60

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# Application Configuration
# =============================================================================
APP_PORT=3000
INTEL_DIR=/app/data/.proj-intel

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
FILE_DATA_TTL=60
PROJECT_STATS_TTL=300
QUERY_RESULT_TTL=120
WATCH_ENABLED=true

# =============================================================================
# Security Configuration
# =============================================================================
API_KEY=your_api_key_here_min_32_chars_long
CORS_ORIGINS=*
MAX_REQUEST_SIZE=10MB
RATE_LIMIT_PER_MINUTE=1000

# JWT Configuration (if using JWT auth)
JWT_SECRET_KEY=your_jwt_secret_key_here_min_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Monitoring Configuration
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8080
PROMETHEUS_WEB_PORT=9090

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/project-context.log

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=secure_grafana_admin_password

# =============================================================================
# Performance Configuration
# =============================================================================
# Worker processes (auto = number of CPU cores)
WORKERS=auto
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30
KEEPALIVE=5

# Memory limits
MAX_MEMORY_USAGE=1GB
GC_THRESHOLD=0.8

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# Let's Encrypt (if using)
LETSENCRYPT_EMAIL=admin@yourdomain.com
LETSENCRYPT_DOMAIN=your-domain.com

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_FILE_WATCHING=true
ENABLE_AUTO_INDEXING=true
ENABLE_QUERY_CACHING=true
ENABLE_METRICS_COLLECTION=true
ENABLE_HEALTH_CHECKS=true
ENABLE_API_DOCUMENTATION=true

# =============================================================================
# Resource Limits
# =============================================================================
MAX_FILE_SIZE=100MB
MAX_PROJECT_SIZE=10GB
MAX_CONCURRENT_REQUESTS=100
INDEX_BATCH_SIZE=1000
QUERY_TIMEOUT_SECONDS=30
