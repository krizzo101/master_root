{
  "plan_id": "simple-example",
  "name": "Simple Parallel Tasks Example",
  "description": "Demonstrates basic ExecutionPlan with parallel task execution",
  "version": "1.0",
  "execution_mode": "parallel",
  "max_parallel_tasks": 3,
  "enable_quality_gates": false,
  "enable_monitoring": true,
  "use_optimizations": true,
  "tasks": [
    {
      "task_id": "analyze_codebase",
      "task_type": "general-purpose",
      "prompt": "Analyze the current codebase structure and identify key components",
      "dependencies": [],
      "context": {
        "focus_areas": ["architecture", "dependencies", "patterns"]
      },
      "validation_level": "standard",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 15
    },
    {
      "task_id": "document_api",
      "task_type": "technical-writer",
      "prompt": "Create comprehensive API documentation based on the code analysis",
      "dependencies": ["analyze_codebase"],
      "context": {
        "output_format": "markdown",
        "include_examples": true
      },
      "validation_level": "standard",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 20
    },
    {
      "task_id": "create_tests",
      "task_type": "qa-testing-guru",
      "prompt": "Generate comprehensive test suite for the analyzed components",
      "dependencies": ["analyze_codebase"],
      "context": {
        "test_types": ["unit", "integration"],
        "coverage_target": 85
      },
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 30
    }
  ],
  "quality_gates": [],
  "phases": [],
  "output_directory": "./output/simple_example",
  "estimated_total_duration_minutes": 45,
  "fallback_strategy": "continue"
}
