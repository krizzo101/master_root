{
  "plan_id": "sdlc-web-app",
  "name": "Web Application SDLC Pipeline",
  "description": "Complete software development lifecycle for a web application",
  "version": "1.0",
  "execution_mode": "mixed",
  "max_parallel_tasks": 4,
  "enable_quality_gates": true,
  "enable_monitoring": true,
  "use_optimizations": true,
  "tasks": [
    {
      "task_id": "requirements_analysis",
      "task_type": "requirements-analyst",
      "prompt": "Analyze and document detailed requirements for a user management web application with authentication, profiles, and role-based access",
      "dependencies": [],
      "phase_id": "discovery",
      "quality_gates": ["discovery_complete"],
      "validation_level": "standard",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 45
    },
    {
      "task_id": "technology_research",
      "task_type": "sdlc-discovery",
      "prompt": "Research and recommend technology stack for the web application including frontend framework, backend API, database, and deployment options",
      "dependencies": [],
      "phase_id": "discovery",
      "quality_gates": ["discovery_complete"],
      "validation_level": "standard",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 30
    },
    {
      "task_id": "system_architecture",
      "task_type": "solution-architect",
      "prompt": "Design comprehensive system architecture including database schema, API design, frontend components, and deployment architecture",
      "dependencies": ["requirements_analysis", "technology_research"],
      "phase_id": "design",
      "quality_gates": ["design_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 60
    },
    {
      "task_id": "api_specification",
      "task_type": "api-integration-specialist",
      "prompt": "Create detailed API specification with OpenAPI/Swagger documentation for all endpoints",
      "dependencies": ["system_architecture"],
      "phase_id": "design",
      "quality_gates": ["design_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 40
    },
    {
      "task_id": "backend_development",
      "task_type": "sdlc-development",
      "prompt": "Implement backend API with user authentication, profile management, and role-based access control",
      "dependencies": ["api_specification"],
      "phase_id": "development",
      "quality_gates": ["development_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 120
    },
    {
      "task_id": "frontend_development",
      "task_type": "development-specialist",
      "prompt": "Implement frontend application with user interface for authentication, profile management, and role-based features",
      "dependencies": ["api_specification"],
      "phase_id": "development",
      "quality_gates": ["development_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 100
    },
    {
      "task_id": "integration_testing",
      "task_type": "qa-testing-guru",
      "prompt": "Create and execute comprehensive integration tests for API endpoints and frontend-backend integration",
      "dependencies": ["backend_development", "frontend_development"],
      "phase_id": "testing",
      "quality_gates": ["testing_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 60
    },
    {
      "task_id": "security_testing",
      "task_type": "security-architect",
      "prompt": "Perform security analysis including authentication testing, authorization checks, and vulnerability assessment",
      "dependencies": ["backend_development", "frontend_development"],
      "phase_id": "testing",
      "quality_gates": ["testing_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 45
    },
    {
      "task_id": "deployment_setup",
      "task_type": "sdlc-deployment",
      "prompt": "Set up production deployment pipeline with containerization, orchestration, and CI/CD integration",
      "dependencies": ["integration_testing", "security_testing"],
      "phase_id": "deployment",
      "quality_gates": ["deployment_complete"],
      "validation_level": "strict",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 50
    },
    {
      "task_id": "documentation",
      "task_type": "technical-writer",
      "prompt": "Create comprehensive project documentation including setup, deployment, API docs, and user guides",
      "dependencies": ["integration_testing"],
      "phase_id": "deployment",
      "quality_gates": ["deployment_complete"],
      "validation_level": "standard",
      "monitoring_enabled": true,
      "estimated_duration_minutes": 40
    }
  ],
  "quality_gates": [
    {
      "gate_id": "discovery_complete",
      "name": "Discovery Phase Complete",
      "description": "Requirements analysis and technology research completed successfully",
      "gate_type": "custom",
      "config": {
        "validation_type": "phase_completion",
        "required_deliverables": ["requirements_document", "technology_recommendations"]
      },
      "dependencies": [],
      "timeout_seconds": 300,
      "enabled": true
    },
    {
      "gate_id": "design_complete",
      "name": "Design Phase Complete",
      "description": "System architecture and API specification completed and approved",
      "gate_type": "custom",
      "config": {
        "validation_type": "phase_completion",
        "required_deliverables": ["architecture_diagram", "api_specification"]
      },
      "dependencies": ["discovery_complete"],
      "timeout_seconds": 300,
      "enabled": true
    },
    {
      "gate_id": "development_complete",
      "name": "Development Phase Complete",
      "description": "Backend and frontend development completed with all features implemented",
      "gate_type": "custom",
      "config": {
        "validation_type": "phase_completion",
        "required_deliverables": ["backend_code", "frontend_code"]
      },
      "dependencies": ["design_complete"],
      "timeout_seconds": 600,
      "enabled": true
    },
    {
      "gate_id": "testing_complete",
      "name": "Testing Phase Complete",
      "description": "All tests passing including integration and security tests",
      "gate_type": "test_results",
      "config": {
        "test_suite_path": "./tests/",
        "minimum_coverage": 80,
        "required_test_types": ["integration", "security"]
      },
      "dependencies": ["development_complete"],
      "timeout_seconds": 400,
      "enabled": true
    },
    {
      "gate_id": "deployment_complete",
      "name": "Deployment Ready",
      "description": "Application successfully deployed and documented",
      "gate_type": "custom",
      "config": {
        "validation_type": "deployment_ready",
        "required_deliverables": ["deployment_pipeline", "documentation"]
      },
      "dependencies": ["testing_complete"],
      "timeout_seconds": 300,
      "enabled": true
    }
  ],
  "phases": [
    {
      "phase_id": "discovery",
      "name": "Discovery & Requirements",
      "description": "Requirements analysis and technology research phase",
      "gates": ["discovery_complete"],
      "parallel_execution": true,
      "max_parallel": 2
    },
    {
      "phase_id": "design",
      "name": "System Design",
      "description": "Architecture and API design phase",
      "gates": ["design_complete"],
      "parallel_execution": true,
      "max_parallel": 2
    },
    {
      "phase_id": "development",
      "name": "Implementation",
      "description": "Backend and frontend development phase",
      "gates": ["development_complete"],
      "parallel_execution": true,
      "max_parallel": 2
    },
    {
      "phase_id": "testing",
      "name": "Quality Assurance",
      "description": "Testing and security validation phase",
      "gates": ["testing_complete"],
      "parallel_execution": true,
      "max_parallel": 2
    },
    {
      "phase_id": "deployment",
      "name": "Deployment & Documentation",
      "description": "Production deployment and documentation phase",
      "gates": ["deployment_complete"],
      "parallel_execution": true,
      "max_parallel": 2
    }
  ],
  "output_directory": "./output/sdlc_webapp",
  "estimated_total_duration_minutes": 590,
  "token_requirements": 4,
  "fallback_strategy": "fail_fast"
}
