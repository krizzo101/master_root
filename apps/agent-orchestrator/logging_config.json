{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "detailed": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(pathname)s:%(lineno)d - %(funcName)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "json": {
      "class": "pythonjsonlogger.jsonlogger.JsonFormatter",
      "format": "%(asctime)s %(name)s %(levelname)s %(pathname)s %(lineno)d %(funcName)s %(message)s"
    },
    "performance": {
      "format": "%(asctime)s - PERF - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    },
    "file_main": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "detailed",
      "filename": "logs/dashboard_production.log",
      "maxBytes": 52428800,
      "backupCount": 10,
      "encoding": "utf8"
    },
    "file_error": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "detailed",
      "filename": "logs/dashboard_errors.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf8"
    },
    "file_access": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "default",
      "filename": "logs/dashboard_access.log",
      "maxBytes": 26214400,
      "backupCount": 7,
      "encoding": "utf8"
    },
    "file_performance": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "performance",
      "filename": "logs/dashboard_performance.log",
      "maxBytes": 10485760,
      "backupCount": 3,
      "encoding": "utf8"
    },
    "syslog": {
      "class": "logging.handlers.SysLogHandler",
      "level": "WARNING",
      "formatter": "default",
      "address": "/dev/log",
      "facility": "daemon"
    }
  },
  "loggers": {
    "dashboard": {
      "level": "INFO",
      "handlers": ["console", "file_main", "file_error"],
      "propagate": false
    },
    "dashboard.access": {
      "level": "INFO",
      "handlers": ["file_access"],
      "propagate": false
    },
    "dashboard.performance": {
      "level": "INFO",
      "handlers": ["file_performance"],
      "propagate": false
    },
    "dashboard.websocket": {
      "level": "INFO",
      "handlers": ["console", "file_main"],
      "propagate": false
    },
    "dashboard.metrics": {
      "level": "INFO",
      "handlers": ["file_main"],
      "propagate": false
    },
    "aiohttp.server": {
      "level": "WARNING",
      "handlers": ["file_main"],
      "propagate": false
    },
    "aiohttp.access": {
      "level": "INFO",
      "handlers": ["file_access"],
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console", "file_main", "syslog"]
  }
}
