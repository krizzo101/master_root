{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Collaboration Message Schemas",
  "version": "1.0.0",
  "definitions": {
    "MessageType": {
      "type": "string",
      "enum": [
        "task_handoff",
        "help_request",
        "status_update",
        "coordination_request",
        "discovery_share",
        "insight_share",
        "research_finding",
        "knowledge_update",
        "file_update",
        "workspace_sync",
        "collaborative_edit",
        "artifact_share",
        "agent_registration",
        "heartbeat",
        "error_notification",
        "system_alert"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"]
    },
    "AgentStatus": {
      "type": "string",
      "enum": ["online", "busy", "idle", "offline", "error"]
    },
    "BaseMessage": {
      "type": "object",
      "required": ["message_id", "message_type", "from_agent", "content", "timestamp"],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the message"
        },
        "message_type": {
          "$ref": "#/definitions/MessageType"
        },
        "from_agent": {
          "type": "string",
          "description": "ID of the sending agent"
        },
        "to_agent": {
          "type": ["string", "null"],
          "description": "ID of recipient agent, null for broadcast"
        },
        "content": {
          "type": "object",
          "description": "Message payload specific to message type"
        },
        "priority": {
          "$ref": "#/definitions/Priority",
          "default": "normal"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when message was created"
        },
        "workspace_id": {
          "type": ["string", "null"],
          "description": "Associated workspace ID if applicable"
        },
        "correlation_id": {
          "type": ["string", "null"],
          "description": "For request/response correlation"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Message expiration time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional metadata"
        }
      },
      "additionalProperties": false
    },
    "AgentInfo": {
      "type": "object",
      "required": ["agent_id", "agent_type", "capabilities", "status", "last_seen"],
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Unique agent identifier"
        },
        "agent_type": {
          "type": "string",
          "description": "Type/role of the agent"
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of agent capabilities"
        },
        "status": {
          "$ref": "#/definitions/AgentStatus"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        },
        "workspace_id": {
          "type": ["string", "null"],
          "description": "Currently active workspace"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Agent-specific metadata"
        }
      },
      "additionalProperties": false
    },
    "TaskHandoffContent": {
      "type": "object",
      "required": ["task_id", "task_type", "task_description", "from_agent", "to_agent"],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique task identifier"
        },
        "task_type": {
          "type": "string",
          "description": "Type of task being handed off"
        },
        "task_description": {
          "type": "string",
          "description": "Detailed task description"
        },
        "from_agent": {
          "type": "string",
          "description": "Agent handing off the task"
        },
        "to_agent": {
          "type": "string",
          "description": "Agent receiving the task"
        },
        "context": {
          "type": "object",
          "additionalProperties": true,
          "description": "Task context and state"
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of dependency task IDs"
        },
        "deadline": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Task deadline"
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "description": "Required resources for the task"
        }
      },
      "additionalProperties": false
    },
    "HelpRequestContent": {
      "type": "object",
      "required": ["request_id", "requesting_agent", "help_type", "description"],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "Unique help request identifier"
        },
        "requesting_agent": {
          "type": "string",
          "description": "Agent requesting help"
        },
        "help_type": {
          "type": "string",
          "enum": ["expertise", "resource", "validation", "escalation"],
          "description": "Type of help needed"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of help needed"
        },
        "context": {
          "type": "object",
          "additionalProperties": true,
          "description": "Context for the help request"
        },
        "urgency": {
          "$ref": "#/definitions/Priority",
          "default": "normal"
        },
        "skills_needed": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Required skills/capabilities"
        }
      },
      "additionalProperties": false
    },
    "StatusUpdateContent": {
      "type": "object",
      "required": ["agent_id", "status"],
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Agent whose status is being updated"
        },
        "status": {
          "$ref": "#/definitions/AgentStatus"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional status metadata"
        },
        "progress": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Task progress percentage"
        },
        "current_task": {
          "type": ["string", "null"],
          "description": "Currently executing task ID"
        }
      },
      "additionalProperties": false
    },
    "DiscoveryShareContent": {
      "type": "object",
      "required": ["discovery_type", "title", "content"],
      "properties": {
        "discovery_type": {
          "type": "string",
          "enum": ["insight", "pattern", "anomaly", "optimization", "finding"],
          "description": "Type of discovery"
        },
        "title": {
          "type": "string",
          "description": "Brief title of the discovery"
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "description": "Discovery details"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence level in the discovery"
        },
        "source_task": {
          "type": ["string", "null"],
          "description": "Task that led to this discovery"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tags for categorization"
        },
        "related_agents": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Agents that might be interested"
        }
      },
      "additionalProperties": false
    },
    "WorkspaceUpdateContent": {
      "type": "object",
      "required": ["workspace_id", "update_type"],
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "Workspace identifier"
        },
        "update_type": {
          "type": "string",
          "enum": ["file_change", "artifact_add", "sync_request", "collaboration_invite"],
          "description": "Type of workspace update"
        },
        "affected_files": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of affected file paths"
        },
        "changes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Details of the changes"
        },
        "version": {
          "type": "string",
          "description": "Version identifier"
        },
        "author": {
          "type": "string",
          "description": "Agent that made the changes"
        }
      },
      "additionalProperties": false
    },
    "ArtifactShareContent": {
      "type": "object",
      "required": ["workspace_id", "artifact"],
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "Workspace containing the artifact"
        },
        "artifact": {
          "type": "object",
          "required": ["artifact_id", "data", "shared_at", "shared_by"],
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique artifact identifier"
            },
            "data": {
              "type": "object",
              "additionalProperties": true,
              "description": "Artifact content"
            },
            "shared_at": {
              "type": "string",
              "format": "date-time",
              "description": "When artifact was shared"
            },
            "shared_by": {
              "type": "string",
              "description": "Agent that shared the artifact"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ErrorNotificationContent": {
      "type": "object",
      "required": ["error_type", "message", "agent_id"],
      "properties": {
        "error_type": {
          "type": "string",
          "enum": ["task_failure", "communication_error", "resource_error", "timeout", "validation_error"],
          "description": "Type of error"
        },
        "message": {
          "type": "string",
          "description": "Error message"
        },
        "agent_id": {
          "type": "string",
          "description": "Agent that encountered the error"
        },
        "task_id": {
          "type": ["string", "null"],
          "description": "Related task ID if applicable"
        },
        "stack_trace": {
          "type": ["string", "null"],
          "description": "Stack trace if available"
        },
        "recovery_suggestions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Suggested recovery actions"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "task_handoff"},
            "content": {"$ref": "#/definitions/TaskHandoffContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "help_request"},
            "content": {"$ref": "#/definitions/HelpRequestContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "status_update"},
            "content": {"$ref": "#/definitions/StatusUpdateContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "discovery_share"},
            "content": {"$ref": "#/definitions/DiscoveryShareContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "workspace_sync"},
            "content": {"$ref": "#/definitions/WorkspaceUpdateContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "artifact_share"},
            "content": {"$ref": "#/definitions/ArtifactShareContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "error_notification"},
            "content": {"$ref": "#/definitions/ErrorNotificationContent"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "agent_registration"},
            "content": {"$ref": "#/definitions/AgentInfo"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/definitions/BaseMessage"},
        {
          "properties": {
            "message_type": {"const": "heartbeat"},
            "content": {
              "type": "object",
              "properties": {
                "agent_id": {"type": "string"},
                "status": {"$ref": "#/definitions/AgentStatus"},
                "last_activity": {"type": "string", "format": "date-time"}
              },
              "required": ["agent_id", "status"],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ]
}
