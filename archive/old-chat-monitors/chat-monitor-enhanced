#!/bin/bash

# Chat Monitor - Unified Claude Code session monitoring tool
# Usage: ./chat-monitor <subcommand> [options]

CHAT_LOGS_DIR="/home/opsvi/.claude/projects"
SCRIPT_NAME="chat-monitor"

# Global variables for session management
declare -A SESSION_COLOR_MAP
declare -A SESSION_SYMBOL_MAP
declare -A SESSION_NAMES
declare -A ACTIVE_SESSIONS
NEXT_COLOR_INDEX=0
VERBOSE_LEVEL=0  # 0=off, 1=basic, 2=detailed, 3=debug
VIEW_LOGGING_LEVEL=0  # 0=off, 1=messages only, 2=+metadata, 3=+raw JSON
VIEW_LOG_FILE="/tmp/chat-monitor-view.log"
VIEW_RAW_LOG_FILE="/tmp/chat-monitor-raw.log"

# Color and symbol palettes
SESSION_COLORS=(
    '\033[31m' '\033[32m' '\033[33m' '\033[34m' '\033[35m' '\033[36m'
    '\033[91m' '\033[92m' '\033[93m' '\033[94m' '\033[95m' '\033[96m'
    '\033[37m' '\033[90m' '\033[97m' '\033[30m'
)
SESSION_SYMBOLS=('●' '◆' '▲' '◀' '▶' '▼' '♦' '♠' '♣' '♥' '★' '✦')

# ANSI Colors
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
CYAN='\033[36m'
WHITE='\033[37m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Enhanced swarm monitoring with agent statistics
cmd_swarm() {
    local detail_level=1  # 0=minimal, 1=smart, 2=verbose, 3=debug
    local show_params=true

    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d|--detail)
                detail_level="$2"
                shift 2
                ;;
            --minimal)
                detail_level=0
                shift
                ;;
            --verbose)
                detail_level=2
                shift
                ;;
            --debug)
                detail_level=3
                shift
                ;;
            -h|--help)
                echo "Usage: $SCRIPT_NAME swarm [options]"
                echo "Enhanced swarm monitoring with agent statistics"
                echo "Options:"
                echo "  -d, --detail LEVEL    Detail level: 0=minimal, 1=smart, 2=verbose, 3=debug"
                echo "      --minimal         Activity indicators only"
                echo "      --verbose         Full details with parameters"
                echo "      --debug           Everything including raw JSON"
                echo ""
                echo "Interactive Controls:"
                echo "  d - Cycle detail levels"
                echo "  s - Show agent statistics"
                echo "  c - Show collaboration patterns"
                echo "  h - Help, q - Quit"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    if ! command -v inotifywait >/dev/null 2>&1; then
        echo "❌ inotifywait required: sudo apt-get install inotify-tools"
        exit 1
    fi

    echo "🐝 Enhanced Swarm Monitor (Detail Level: $detail_level)"
    echo "📂 Directory: $CHAT_LOGS_DIR"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "💡 Agent statistics and collaboration tracking enabled"
    echo "🎛️  Press 'd' to cycle detail levels, 's' for stats, 'c' for collaboration"
    echo ""

    # Track sessions and their relationships
    declare -A session_activities
    declare -A session_tools
    declare -A session_colors
    declare -A last_activity
    declare -A tool_sequences
    declare -A files_created
    declare -A files_modified
    declare -A task_counts
    declare -A agent_spawns
    declare -A error_counts

    # Enhanced display function with agent tracking
    display_enhanced_entry() {
        local session_id="$1"
        local line="$2"
        local current_detail_level="$3"

        [[ ! "$line" =~ ^[[:space:]]*\{ ]] && return

        if command -v jq >/dev/null 2>&1; then
            local timestamp=$(echo "$line" | jq -r '.timestamp // empty' 2>/dev/null)
            local message_type=$(echo "$line" | jq -r '.type // empty' 2>/dev/null)
            local time_display="${timestamp:11:8}"

            # Assign colors if not exists
            if [[ -z "${session_colors[$session_id]}" ]]; then
                local color_index=$((${#session_colors[@]} % 6))
                local colors=('\033[31m' '\033[32m' '\033[33m' '\033[34m' '\033[35m' '\033[36m')
                session_colors[$session_id]="${colors[$color_index]}"
            fi

            local color="${session_colors[$session_id]}"
            local reset='\033[0m'
            local dim='\033[2m'
            local bold='\033[1m'

            case "$message_type" in
                "user")
                    local content=$(echo "$line" | jq -r '.message.content[0].content // .message.content // empty' 2>/dev/null)
                    if [[ "$content" != "null" && -n "$content" ]]; then
                        case $current_detail_level in
                            0) # Minimal - just activity indicator
                                echo -e "${dim}[$time_display]${reset} ${color}●${reset} ${session_id:0:6}"
                                ;;
                            1) # Smart - key info only
                                local preview="${content:0:60}"
                                [[ ${#content} -gt 60 ]] && preview+="..."
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}USER${reset} ${color}${session_id:0:8}${reset}: $preview"
                                ;;
                            2|3) # Verbose/Debug - full content
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}USER${reset} ${color}${session_id:0:8}${reset}:"
                                echo -e "  ${dim}│${reset} $content"
                                [[ $current_detail_level -eq 3 ]] && echo -e "  ${dim}└─ Length: ${#content} chars${reset}"
                                ;;
                        esac

                        # Track user activity
                        session_activities[$session_id]="USER: ${content:0:40}"
                        last_activity[$session_id]=$(date +%s)
                    fi
                    ;;
                "assistant")
                    local tool_name=$(echo "$line" | jq -r '.message.content[0].name // empty' 2>/dev/null)
                    local content=$(echo "$line" | jq -r '.message.content[0].text // empty' 2>/dev/null)

                    if [[ "$tool_name" != "null" && -n "$tool_name" ]]; then
                        # Tool usage - track agent activity
                        local tool_params=""
                        if [[ $show_params == true && $current_detail_level -ge 1 ]]; then
                            local raw_params=$(echo "$line" | jq -r '.message.content[0].input // empty' 2>/dev/null)
                            if [[ "$raw_params" != "null" && -n "$raw_params" ]]; then
                                case "$tool_name" in
                                    "Task")
                                        local agent_type=$(echo "$raw_params" | jq -r '.subagent_type // empty' 2>/dev/null)
                                        local desc=$(echo "$raw_params" | jq -r '.description // empty' 2>/dev/null)
                                        tool_params="→ $agent_type: ${desc:0:40}"
                                        [[ ${#desc} -gt 40 ]] && tool_params+="..."
                                        # Track agent spawns
                                        agent_spawns[$session_id]=$((${agent_spawns[$session_id]:-0} + 1))
                                        ;;
                                    "mcp__claude-code-wrapper__claude_run_async")
                                        local task_desc=$(echo "$raw_params" | jq -r '.task // empty' 2>/dev/null)
                                        tool_params="→ ASYNC: ${task_desc:0:50}"
                                        [[ ${#task_desc} -gt 50 ]] && tool_params+="..."
                                        # Track collaboration
                                        agent_spawns[$session_id]=$((${agent_spawns[$session_id]:-0} + 1))
                                        ;;
                                    "Bash")
                                        local command=$(echo "$raw_params" | jq -r '.command // empty' 2>/dev/null)
                                        tool_params="→ ${command:0:50}"
                                        [[ ${#command} -gt 50 ]] && tool_params+="..."
                                        ;;
                                    "Read"|"Write"|"Edit")
                                        local filepath=$(echo "$raw_params" | jq -r '.file_path // empty' 2>/dev/null)
                                        local filename=$(basename "$filepath" 2>/dev/null || echo "$filepath")
                                        tool_params="→ $filename"

                                        # Track file operations
                                        if [[ "$tool_name" == "Write" ]]; then
                                            files_created[$session_id]="${files_created[$session_id]:-} $filename"
                                        elif [[ "$tool_name" == "Edit" ]]; then
                                            files_modified[$session_id]="${files_modified[$session_id]:-} $filename"
                                        fi
                                        ;;
                                    *)
                                        tool_params="→ $(echo "$raw_params" | head -c 60)"
                                        [[ ${#raw_params} -gt 60 ]] && tool_params+="..."
                                        ;;
                                esac
                            fi
                        fi

                        case $current_detail_level in
                            0) # Minimal
                                echo -e "${dim}[$time_display]${reset} ${color}⚡${reset} ${session_id:0:6} $tool_name"
                                ;;
                            1) # Smart
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}TOOL${reset} ${color}${session_id:0:8}${reset}: ${bold}$tool_name${reset} $tool_params"
                                ;;
                            2) # Verbose
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}TOOL${reset} ${color}${session_id:0:8}${reset}: ${bold}$tool_name${reset}"
                                [[ -n "$tool_params" ]] && echo -e "  ${dim}│${reset} $tool_params"
                                ;;
                            3) # Debug
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}TOOL${reset} ${color}${session_id:0:8}${reset}: ${bold}$tool_name${reset}"
                                [[ -n "$tool_params" ]] && echo -e "  ${dim}│${reset} $tool_params"
                                echo -e "  ${dim}└─ Raw: $(echo "$raw_params" | head -c 100)${reset}"
                                ;;
                        esac

                        # Track tool sequences and task completion
                        tool_sequences[$session_id]+="$tool_name→"
                        session_tools[$session_id]="$tool_name"
                        task_counts[$session_id]=$((${task_counts[$session_id]:-0} + 1))

                        # Detect collaboration patterns
                        if [[ "$tool_name" =~ (Task|mcp__claude-code-wrapper) ]]; then
                            echo -e "    ${color}🤝 COLLABORATION DETECTED${reset} - Agent spawning in progress"
                        fi

                    elif [[ "$content" != "null" && -n "$content" ]]; then
                        # Assistant response
                        case $current_detail_level in
                            0) # Minimal
                                echo -e "${dim}[$time_display]${reset} ${color}💬${reset} ${session_id:0:6}"
                                ;;
                            1) # Smart
                                local preview="${content:0:80}"
                                [[ ${#content} -gt 80 ]] && preview+="..."
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}ASST${reset} ${color}${session_id:0:8}${reset}: $preview"
                                ;;
                            2|3) # Verbose/Debug
                                echo -e "${dim}[$time_display]${reset} ${color}${bold}ASST${reset} ${color}${session_id:0:8}${reset}:"
                                if [[ ${#content} -gt 200 ]]; then
                                    echo -e "  ${dim}│${reset} ${content:0:150}..."
                                    echo -e "  ${dim}└─ [${#content} chars total]${reset}"
                                else
                                    echo -e "  ${dim}│${reset} $content"
                                fi
                                ;;
                        esac
                    fi
                    ;;
            esac
        fi
    }

    # Show comprehensive agent statistics
    show_agent_stats() {
        local total_agents=${#session_activities[@]}
        local total_tasks=0
        local total_agents_spawned=0
        local total_files_created=0
        local total_files_modified=0

        # Calculate totals
        for session_id in "${!task_counts[@]}"; do
            total_tasks=$((total_tasks + ${task_counts[$session_id]:-0}))
        done
        for session_id in "${!agent_spawns[@]}"; do
            total_agents_spawned=$((total_agents_spawned + ${agent_spawns[$session_id]:-0}))
        done
        for session_id in "${!files_created[@]}"; do
            local count=$(echo "${files_created[$session_id]}" | wc -w)
            total_files_created=$((total_files_created + count))
        done
        for session_id in "${!files_modified[@]}"; do
            local count=$(echo "${files_modified[$session_id]}" | wc -w)
            total_files_modified=$((total_files_modified + count))
        done

        echo -e "\n${BOLD}📊 AGENT SWARM STATISTICS${RESET}"
        echo -e "${DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${BOLD}Active Agents:${RESET} $total_agents"
        echo -e "${BOLD}Agents Spawned:${RESET} $total_agents_spawned 🤖"
        echo -e "${BOLD}Tasks Completed:${RESET} $total_tasks ✅"
        echo -e "${BOLD}Files Created:${RESET} $total_files_created 📝"
        echo -e "${BOLD}Files Modified:${RESET} $total_files_modified ✏️"
        echo ""

        # Show individual agent details
        if [[ $detail_level -ge 1 ]]; then
            echo -e "${BOLD}🔍 INDIVIDUAL AGENT STATUS${RESET}"
            echo -e "${DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
            for session_id in "${!session_activities[@]}"; do
                local color="${session_colors[$session_id]}"
                local last_tool="${session_tools[$session_id]:-"idle"}"
                local tasks="${task_counts[$session_id]:-0}"
                local spawned="${agent_spawns[$session_id]:-0}"
                local created_files="${files_created[$session_id]:-""}"
                local modified_files="${files_modified[$session_id]:-""}"

                echo -e "${color}${BOLD}${session_id:0:12}${RESET}:"
                echo -e "  Last Tool: $last_tool"
                echo -e "  Tasks: $tasks | Spawned: $spawned agents"
                [[ -n "$created_files" ]] && echo -e "  Created: $(echo $created_files | tr ' ' ', ')"
                [[ -n "$modified_files" ]] && echo -e "  Modified: $(echo $modified_files | tr ' ' ', ')"
                echo ""
            done
        fi
    }

    # Interactive controls in background
    control_loop() {
        while true; do
            read -t 10 -n 1 key 2>/dev/null
            case "$key" in
                d)
                    detail_level=$(((detail_level + 1) % 4))
                    local level_names=("MINIMAL" "SMART" "VERBOSE" "DEBUG")
                    echo -e "\n${BOLD}Detail level: ${level_names[$detail_level]}${RESET}\n"
                    ;;
                s)
                    update_stats_panel
                    ;;
                c)
                    echo -e "\n${BOLD}🤝 COLLABORATION PATTERNS:${RESET}"
                    for session_id in "${!tool_sequences[@]}"; do
                        local sequence="${tool_sequences[$session_id]}"
                        if [[ "$sequence" =~ Task.*→ ]]; then
                            local color="${session_colors[$session_id]}"
                            echo -e "  ${color}${session_id:0:8}${RESET}: $sequence"
                        fi
                    done
                    echo ""
                    ;;
                h)
                    echo -e "\n${BOLD}Controls:${RESET} d=detail, s=stats, c=collaboration, q=quit, h=help\n"
                    ;;
                q)
                    tput rmcup  # Restore screen
                    echo -e "\n${BOLD}Enhanced swarm monitor stopped.${RESET}"
                    exit 0
                    ;;
            esac
        done
    }

    # Start control loop in background
    control_loop &
    local control_pid=$!
    trap "kill $control_pid 2>/dev/null; exit" INT TERM

    # Create split-screen interface
    setup_split_screen() {
        # Clear screen and set up split layout
        clear
        tput smcup  # Save screen state

        # Get terminal dimensions
        local term_height=$(tput lines)
        local term_width=$(tput cols)
        local stats_height=12
        local log_height=$((term_height - stats_height - 2))

        # Draw static statistics panel at top
        tput cup 0 0
        echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "${BOLD}🐝 AGENT SWARM DASHBOARD${RESET}                                    $(date '+%H:%M:%S')"
        echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════════${RESET}"

        # Reserve space for stats (will be updated in place)
        for ((i=0; i<$stats_height; i++)); do
            echo ""
        done

        echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "${BOLD}📄 LIVE AGENT ACTIVITY LOG${RESET}                       Press 's' to refresh stats"
        echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════════${RESET}"

        # Set scroll region for logs only (bottom part)
        local log_start=$((stats_height + 5))
        tput csr $log_start $term_height
        tput cup $log_start 0
    }

    # Update statistics panel in place (without scrolling)
    update_stats_panel() {
        local saved_row=$(tput row)
        local saved_col=$(tput col)

        # Calculate stats
        local total_agents=${#session_activities[@]}
        local total_tasks=0
        local total_agents_spawned=0
        local total_files_created=0
        local total_files_modified=0

        for session_id in "${!task_counts[@]}"; do
            total_tasks=$((total_tasks + ${task_counts[$session_id]:-0}))
        done
        for session_id in "${!agent_spawns[@]}"; do
            total_agents_spawned=$((total_agents_spawned + ${agent_spawns[$session_id]:-0}))
        done
        for session_id in "${!files_created[@]}"; do
            local count=$(echo "${files_created[$session_id]}" | wc -w)
            total_files_created=$((total_files_created + count))
        done
        for session_id in "${!files_modified[@]}"; do
            local count=$(echo "${files_modified[$session_id]}" | wc -w)
            total_files_modified=$((total_files_modified + count))
        done

        # Update stats panel in place
        tput cup 3 0
        tput ed  # Clear from cursor to end of screen region

        echo -e "${BOLD}📊 REAL-TIME STATISTICS${RESET}                                     $(date '+%H:%M:%S')"
        echo -e "   Active Agents: ${GREEN}$total_agents${RESET}  |  Agents Spawned: ${YELLOW}$total_agents_spawned${RESET} 🤖"
        echo -e "   Tasks Completed: ${BLUE}$total_tasks${RESET} ✅  |  Files: ${CYAN}$total_files_created${RESET}📝 ${MAGENTA}$total_files_modified${RESET}✏️"
        echo ""

        if [[ $total_agents -gt 0 ]]; then
            echo -e "${BOLD}🔍 ACTIVE AGENTS${RESET}"
            local count=0
            for session_id in "${!session_activities[@]}"; do
                [[ $count -ge 6 ]] && break  # Limit to 6 agents in panel
                local color="${session_colors[$session_id]}"
                local last_tool="${session_tools[$session_id]:-"idle"}"
                local tasks="${task_counts[$session_id]:-0}"
                local spawned="${agent_spawns[$session_id]:-0}"
                echo -e "   ${color}${session_id:0:10}${RESET}: $last_tool (T:$tasks S:$spawned)"
                ((count++))
            done
            [[ ${#session_activities[@]} -gt 6 ]] && echo -e "   ${DIM}... and $((${#session_activities[@]} - 6)) more agents${RESET}"
        else
            echo -e "${DIM}   No active agents detected${RESET}"
            echo ""
            echo ""
            echo ""
        fi

        # Restore cursor position for log output
        tput cup $saved_row $saved_col
    }

    # Set up the split screen interface
    setup_split_screen

    # Update stats panel every 5 seconds
    (
        while true; do
            sleep 5
            update_stats_panel
        done
    ) &
    local summary_pid=$!
    trap "kill $control_pid $summary_pid 2>/dev/null; tput rmcup; exit" INT TERM

    # Monitor files with enhanced display - recursively watch all subdirectories
    inotifywait -m -q -r --format '%w%f %e' -e modify "$CHAT_LOGS_DIR" | while read filepath event; do
        [[ "$filepath" =~ \.jsonl$ ]] || continue

        local session_id=$(basename "$filepath" .jsonl)
        local latest_line=$(tail -n 1 "$filepath" 2>/dev/null)
        [[ -z "$latest_line" ]] && continue

        display_enhanced_entry "$session_id" "$latest_line" "$detail_level"
    done
}

# [... include other original commands like basic, lazy, interactive, etc. from backup ...]

# Main dispatcher - keeping original structure
main() {
    if [[ $# -eq 0 ]]; then
        echo "Chat Monitor - Unified Claude Code session monitoring"
        echo "Usage: $SCRIPT_NAME <subcommand> [options]"
        echo ""
        echo "Subcommands:"
        echo "  swarm           Enhanced swarm monitoring with agent statistics"
        echo "  basic           Basic tail-based monitoring"
        echo "  lazy            Efficient inotify-based monitoring"
        echo "  interactive     Full TUI with view switching"
        echo ""
        echo "Run '$SCRIPT_NAME <subcommand> --help' for subcommand-specific options."
        exit 0
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        swarm)
            cmd_swarm "$@"
            ;;
        basic|lazy|interactive|triple-pane|quad-pane|grid|cleanup|kill-all)
            echo "⚠️  Command '$subcommand' available in backup: ./chat-monitor-backup $subcommand"
            echo "💡 Enhanced swarm monitoring available with: $SCRIPT_NAME swarm"
            ;;
        -h|--help|help)
            main
            ;;
        *)
            echo "❌ Unknown subcommand: $subcommand"
            echo "Available: swarm (enhanced), or use ./chat-monitor-backup for legacy commands"
            exit 1
            ;;
    esac
}

main "$@"
