{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opsvi/master_root/.claude/hooks/display-reminders.sh"
          }
        ]
      }
    ],
    "Stop": [
    ],
    "SubagentStop": [
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys; d=json.load(sys.stdin); p=d.get('tool_input',{}).get('file_path',''); sys.exit(2 if any(x in p for x in ['.env','secrets','credentials','password']) else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"/home/opsvi/master_root/.claude/hooks/post-edit.sh\" ]; then /home/opsvi/master_root/.claude/hooks/post-edit.sh; fi"
          }
        ]
      }
    ],
    "SessionStart": [
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/opsvi/master_root/.claude/hooks/pre-compact-export-v2.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"/home/opsvi/master_root/.claude/hooks/export-session.sh\" ]; then /home/opsvi/master_root/.claude/hooks/export-session.sh $TRANSCRIPT_PATH SessionEnd; fi"
          }
        ]
      }
    ]
  }
}
