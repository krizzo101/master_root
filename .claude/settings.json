{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type":"command", "command":"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt_opt.py", "timeout": 45 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type":"command", "command":"$CLAUDE_PROJECT_DIR/.claude/hooks/answer_review.py", "timeout": 60 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type":"command", "command":"$CLAUDE_PROJECT_DIR/.claude/hooks/answer_review.py", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type":"command", "command":"$CLAUDE_PROJECT_DIR/.claude/hooks/safety_gate.py", "timeout": 20 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys; d=json.load(sys.stdin); p=d.get('tool_input',{}).get('file_path',''); sys.exit(2 if any(x in p for x in ['.env','secrets','credentials','password']) else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|Task",
        "hooks": [
          { "type":"command", "command":"$CLAUDE_PROJECT_DIR/.claude/hooks/answer_review.py", "timeout": 45 }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\" ]; then $CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session started: '$(date '+%Y-%m-%d %H:%M:%S')"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact-export-v2.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/export-session.sh\" ]; then $CLAUDE_PROJECT_DIR/.claude/hooks/export-session.sh $TRANSCRIPT_PATH SessionEnd; fi"
          }
        ]
      }
    ]
  }
}
