{
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-a9cc6620c7b24c9c90bd010c73deb51f"
      }
    },
    "tech_docs": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "web_search": {
      "command": "npx",
      "args": [
        "-y",
        "brave-search-mcp"
      ],
      "env": {
        "BRAVE_API_KEY": "BSAqv6fii19i_ZRARk67Gs5udOHgxSN"
      }
    },
    "knowledge": {
      "command": "/home/opsvi/miniconda/bin/python",
      "args": [
        "-m",
        "opsvi_mcp.servers.knowledge.server"
      ],
      "env": {
        "PYTHONPATH": "/home/opsvi/master_root/libs:/home/opsvi/master_root/apps",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password",
        "EMBEDDING_SERVICE_URL": "http://localhost:8001",
        "KNOWLEDGE_LOG_LEVEL": "INFO"
      }
    },
    "thinking": {
      "command": "/home/opsvi/miniconda/bin/python",
      "args": [
        "-m",
        "opsvi_mcp.servers.thinking"
      ],
      "env": {
        "PYTHONPATH": "/home/opsvi/master_root/libs:/home/opsvi/master_root/apps",
        "OPENAI_API_KEY": "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",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password",
        "TRIAGE_MODE": "full"
      }
    },
    "time": {
      "command": "npx",
      "args": [
        "-y",
        "time-mcp"
      ]
    },
    "shell_exec": {
      "command": "npx",
      "args": [
        "-y",
        "@mkusaka/mcp-shell-server",
        "-w",
        "/home/opsvi/master_root"
      ],
      "env": {
        "SHELL": "/bin/bash"
      }
    }
  }
}