# Basic monitoring (like old tail-chat-logs.sh)
cmd_basic() {
    local tail_lines=0
    local session_filter=""

    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: $SCRIPT_NAME basic [options]"
                echo "Options:"
                echo "  -n, --lines NUM     Show last NUM lines from each file (default: 0)"
                echo "  -a, --all           Show all historical logs"
                echo "  -r, --recent        Show last 10 lines from each file"
                echo "  -s, --session [ID]  Monitor specific session"
                echo "  -v, --verbose [LVL] Verbose logging: 1=basic, 2=detailed, 3=debug (default: 1)"
                echo "  -l, --log-view [LVL] View logging: 1=messages, 2=+metadata, 3=+raw JSON (default: 1)"
                echo "Log files: $VIEW_LOG_FILE, $VIEW_RAW_LOG_FILE"
                exit 0
                ;;
            -n|--lines)
                tail_lines="$2"
                shift 2
                ;;
            -a|--all)
                tail_lines="+1"
                shift
                ;;
            -r|--recent)
                tail_lines=10
                shift
                ;;
            -s|--session)
                if [[ -n "$2" && ! "$2" =~ ^- ]]; then
                    session_filter="$2"
                    shift 2
                else
                    session_filter=$(select_session)
                    shift
                fi
                ;;
            -v|--verbose)
                if [[ -n "$2" && "$2" =~ ^[1-3]$ ]]; then
                    VERBOSE_LEVEL="$2"
                    shift 2
                else
                    VERBOSE_LEVEL=1  # Default to level 1
                    shift
                fi
                ;;
            -l|--log-view)
                if [[ -n "$2" && "$2" =~ ^[1-3]$ ]]; then
                    VIEW_LOGGING_LEVEL="$2"
                    shift 2
                else
                    VIEW_LOGGING_LEVEL=1  # Default to level 1
                    shift
                fi
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    echo "🔍 Basic Chat Monitor"
    echo "📂 Directory: $CHAT_LOGS_DIR"
    echo "⏰ Started: $(date)"
    [[ -n "$session_filter" ]] && echo "🎯 Session: $session_filter"
    show_logging_status
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    verbose_log 1 "Basic monitor started with tail_lines=$tail_lines, session_filter='$session_filter'"
    verbose_log 2 "Verbose level: $VERBOSE_LEVEL, View logging level: $VIEW_LOGGING_LEVEL"
    log_view_output 1 "SESSION START - Basic Monitor - Filter: ${session_filter:-ALL}"

    # Monitor files
    if [[ -n "$session_filter" ]]; then
        find "$CHAT_LOGS_DIR" -name "${session_filter}*.jsonl" -type f -print0 | \
            xargs -0 tail -n "$tail_lines" -f | \
            while IFS= read -r line; do
                display_log_entry "SESSION" "$line" false
            done
    else
        find "$CHAT_LOGS_DIR" -name "*.jsonl" -type f -print0 | \
            xargs -0 tail -n "$tail_lines" -f | \
            while IFS= read -r line; do
                display_log_entry "MULTI" "$line" true
            done
    fi
}

# Lazy monitoring (efficient inotify-based)
cmd_lazy() {
    # Parse options for global flags
    while [[ $# -gt 0 ]]; do
        case $1 in
            -v|--verbose)
                if [[ -n "$2" && "$2" =~ ^[1-3]$ ]]; then
                    VERBOSE_LEVEL="$2"
                    shift 2
                else
                    VERBOSE_LEVEL=1
                    shift
                fi
                ;;
            -l|--log-view)
                if [[ -n "$2" && "$2" =~ ^[1-3]$ ]]; then
                    VIEW_LOGGING_LEVEL="$2"
                    shift 2
                else
                    VIEW_LOGGING_LEVEL=1
                    shift
                fi
                ;;
            -h|--help)
                echo "Usage: $SCRIPT_NAME lazy [options]"
                echo "Options:"
                echo "  -v, --verbose [LVL] Verbose logging: 1=basic, 2=detailed, 3=debug"
                echo "  -l, --log-view [LVL] View logging: 1=messages, 2=+metadata, 3=+raw JSON"
                echo "Log files: $VIEW_LOG_FILE, $VIEW_RAW_LOG_FILE"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    if ! command -v inotifywait >/dev/null 2>&1; then
        echo "❌ inotifywait required: sudo apt-get install inotify-tools"
        exit 1
    fi

    echo "⚡ Lazy Chat Monitor - Zero overhead until activity"
    echo "📂 Directory: $CHAT_LOGS_DIR"
    show_logging_status
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    verbose_log 1 "Lazy monitor started - waiting for file modifications"
    verbose_log 2 "inotifywait monitoring: $CHAT_LOGS_DIR"
    log_view_output 1 "SESSION START - Lazy Monitor"

    # Monitor for file changes
    inotifywait -m -q --format '%w%f %e' -e modify "$CHAT_LOGS_DIR" | while read filepath event; do
        [[ "$filepath" =~ \.jsonl$ ]] || continue

        local session_id=$(basename "$filepath" .jsonl)
        local latest_line=$(tail -n 1 "$filepath" 2>/dev/null)
        [[ -z "$latest_line" ]] && continue

        display_log_entry "$session_id" "$latest_line" true
    done
}

# Interactive TUI (like old interactive-chat-monitor.sh)
cmd_interactive() {
    if ! command -v inotifywait >/dev/null 2>&1; then
        echo "❌ inotifywait required: sudo apt-get install inotify-tools"
        exit 1
    fi

    # Terminal setup
    stty -echo
    tput civis
    tput smcup
    clear

    local current_view="consolidated"
    local selected_session=""
    local monitor_pid=""

    # Cleanup function
    cleanup() {
        [[ -n "$monitor_pid" ]] && kill "$monitor_pid" 2>/dev/null
        tput rmcup
        tput cnorm
        stty echo
        echo -e "\n${GREEN}Interactive monitor stopped.${RESET}"
        exit 0
    }
    trap 'cleanup' INT TERM EXIT

    # Background monitoring
    monitor_logs() {
        inotifywait -m -q --format '%w%f %e' -e modify "$CHAT_LOGS_DIR" | while read filepath event; do
            [[ "$filepath" =~ \.jsonl$ ]] || continue

            local session_id=$(basename "$filepath" .jsonl)
            local latest_line=$(tail -n 1 "$filepath" 2>/dev/null)
            [[ -z "$latest_line" ]] && continue

            if [[ "$current_view" == "consolidated" ]]; then
                display_log_entry "$session_id" "$latest_line" true
            elif [[ "$current_view" == "session" && "$session_id" == "$selected_session" ]]; then
                display_log_entry "$session_id" "$latest_line" false
            fi
        done
    }

    # Start monitoring
    monitor_logs &
    monitor_pid=$!

    # Interface loop
    echo -e "${BOLD}${CYAN}Interactive Chat Monitor${RESET}"
    echo -e "${DIM}Press 'h' for help, 'q' to quit${RESET}"
    echo ""

    while true; do
        read -t 1 -n 1 key 2>/dev/null || continue
        case "$key" in
            c)
                current_view="consolidated"
                clear
                echo -e "${GREEN}Switched to consolidated view${RESET}"
                ;;
            s)
                selected_session=$(select_session)
                current_view="session"
                clear
                echo -e "${GREEN}Monitoring session: $selected_session${RESET}"
                ;;
            v)
                # Cycle through verbose levels: 0 -> 1 -> 2 -> 3 -> 0
                VERBOSE_LEVEL=$(((VERBOSE_LEVEL + 1) % 4))
                local verbose_desc=("OFF" "BASIC" "DETAILED" "DEBUG")
                echo -e "${GREEN}Verbose level: ${verbose_desc[$VERBOSE_LEVEL]}${RESET}"
                verbose_log 1 "User cycled verbose level to $VERBOSE_LEVEL"
                ;;
            l)
                # Cycle through view logging levels: 0 -> 1 -> 2 -> 3 -> 0
                VIEW_LOGGING_LEVEL=$(((VIEW_LOGGING_LEVEL + 1) % 4))
                local view_desc=("OFF" "MESSAGES" "+METADATA" "+RAW_JSON")
                echo -e "${GREEN}View logging level: ${view_desc[$VIEW_LOGGING_LEVEL]}${RESET}"
                if [[ $VIEW_LOGGING_LEVEL -gt 0 ]]; then
                    echo -e "${DIM}Logging to: $VIEW_LOG_FILE$([ $VIEW_LOGGING_LEVEL -eq 3 ] && echo " & $VIEW_RAW_LOG_FILE")${RESET}"
                fi
                verbose_log 1 "User cycled view logging level to $VIEW_LOGGING_LEVEL"
                ;;
            h)
                clear
                echo -e "${BOLD}Interactive Monitor Help${RESET}"
                echo "c - Consolidated view (all sessions)"
                echo "s - Session selector"
                echo "v - Cycle verbose level (0=OFF, 1=BASIC, 2=DETAILED, 3=DEBUG)"
                echo "l - Cycle view logging (0=OFF, 1=MESSAGES, 2=+METADATA, 3=+RAW)"
                echo "q - Quit"
                echo ""
                show_logging_status
                echo ""
                echo "Log files: $VIEW_LOG_FILE, $VIEW_RAW_LOG_FILE"
                echo ""
                echo "Press any key to continue..."
                read -n 1
                clear
                ;;
            q)
                break
                ;;
        esac
    done
}

# Triple pane layout
cmd_triple_pane() {
    if ! command -v tmux >/dev/null 2>&1; then
        echo "❌ tmux required: sudo apt-get install tmux"
        exit 1
    fi

    local session_name="chat-triple-pane"
    local available_sessions=($(get_recent_sessions))

    if [[ ${#available_sessions[@]} -eq 0 ]]; then
        echo "🔄 No active sessions found."
        echo "💡 Try: './chat-monitor lazy' to wait for sessions"
        echo "   or: './chat-monitor triple-pane --auto' once you have sessions"
        exit 1
    elif [[ ${#available_sessions[@]} -lt 3 ]]; then
        echo "⚠️  Only ${#available_sessions[@]} sessions available"
        echo "🤖 Auto-selecting available sessions and duplicating to fill 3 panes"
    fi

    echo "🖥️  Triple Pane Setup - Select 3 sessions"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Show available sessions
    echo "📋 Available sessions:"
    for i in "${!available_sessions[@]}"; do
        IFS='|' read -r session_id filepath display_name <<< "${available_sessions[$i]}"
        echo "  $((i+1)). $display_name"
    done
    echo ""

    # Get 3 sessions
    local selected_sessions=()
    for pane_num in {1..3}; do
        local positions=("top" "middle" "bottom")
        local position="${positions[$((pane_num-1))]}"

        while true; do
            echo -n "🎯 Select session for $position pane (1-${#available_sessions[@]}): "
            read -r choice

            if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -le ${#available_sessions[@]} ]]; then
                local selected_index=$((choice - 1))
                selected_sessions+=("${available_sessions[$selected_index]}")
                break
            else
                echo "❌ Invalid choice"
            fi
        done
    done

    # Create tmux session
    tmux kill-session -t "$session_name" 2>/dev/null
    tmux new-session -d -s "$session_name" -c "$PWD"

    # Create vertical splits
    tmux split-window -v -t "$session_name:0"
    tmux split-window -v -t "$session_name:0.1"

    # Set up each pane
    local pane_colors=('\033[31m' '\033[33m' '\033[35m')
    for i in {0..2}; do
        IFS='|' read -r session_id filepath display_name <<< "${selected_sessions[$i]}"
        local color="${pane_colors[$i]}"

        # Create formatter for this pane
        cat > "./triple-formatter-$i.sh" << EOF
#!/bin/bash
COLOR='$color'
DISPLAY_NAME='$display_name'
RESET='\033[0m'
BOLD='\033[1m'

echo -e "\${COLOR}\${BOLD}=== \$DISPLAY_NAME ===\${RESET}"

while IFS= read -r line; do
    [[ ! "\$line" =~ ^[[:space:]]*\\{ ]] && continue

    if command -v jq >/dev/null 2>&1; then
        timestamp=\$(echo "\$line" | jq -r '.timestamp // empty' 2>/dev/null)
        message_type=\$(echo "\$line" | jq -r '.type // empty' 2>/dev/null)
        time_display="\${timestamp:11:8}"

        case "\$message_type" in
            "user")
                content=\$(echo "\$line" | jq -r '.message.content[0].content // .message.content // empty' 2>/dev/null)
                if [[ "\$content" != "null" && -n "\$content" ]]; then
                    if [[ \${#content} -gt 50 ]]; then
                        content="\${content:0:47}..."
                    fi
                    echo -e "[\$time_display] \${COLOR}USER:\${RESET} \$content"
                fi
                ;;
            "assistant")
                tool_name=\$(echo "\$line" | jq -r '.message.content[0].name // empty' 2>/dev/null)
                content=\$(echo "\$line" | jq -r '.message.content[0].text // empty' 2>/dev/null)

                if [[ "\$tool_name" != "null" && -n "\$tool_name" ]]; then
                    echo -e "[\$time_display] \${COLOR}TOOL:\${RESET} \$tool_name"
                elif [[ "\$content" != "null" && -n "\$content" ]]; then
                    if [[ \${#content} -gt 50 ]]; then
                        content="\${content:0:47}..."
                    fi
                    echo -e "[\$time_display] \${COLOR}ASST:\${RESET} \$content"
                fi
                ;;
        esac
    fi
done
EOF
        chmod +x "./triple-formatter-$i.sh"

        # Start monitoring in pane
        tmux send-keys -t "$session_name:0.$i" "tail -n 3 -f '$filepath' | ./triple-formatter-$i.sh" Enter
    done

    echo "✅ Triple pane monitor ready!"
    echo "🎮 Controls: Ctrl+b, ↑↓ to navigate panes"
    echo "🚪 Exit: Ctrl+b, x, y (kill session) or Ctrl+b, d (detach)"
    sleep 3

    # Cleanup formatters on exit
    cleanup_triple() {
        rm -f ./triple-formatter-*.sh
    }
    trap 'cleanup_triple' EXIT

    tmux attach-session -t "$session_name"
}

# Quad pane layout
cmd_quad_pane() {
    if ! command -v tmux >/dev/null 2>&1; then
        echo "❌ tmux required: sudo apt-get install tmux"
        exit 1
    fi

    local session_name="chat-quad-pane"
    local available_sessions=($(get_recent_sessions))

    if [[ ${#available_sessions[@]} -lt 4 ]]; then
        echo "❌ Need at least 4 recent sessions for quad pane"
        exit 1
    fi

    echo "🖥️  Quad Pane Setup - Select 4 sessions (2x2 grid)"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Show available sessions
    echo "📋 Available sessions:"
    for i in "${!available_sessions[@]}"; do
        IFS='|' read -r session_id filepath display_name <<< "${available_sessions[$i]}"
        echo "  $((i+1)). $display_name"
    done
    echo ""

    # Get 4 sessions
    local selected_sessions=()
    for pane_num in {1..4}; do
        local positions=("top-left" "top-right" "bottom-left" "bottom-right")
        local position="${positions[$((pane_num-1))]}"

        while true; do
            echo -n "🎯 Select session for $position pane (1-${#available_sessions[@]}): "
            read -r choice

            if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -le ${#available_sessions[@]} ]]; then
                local selected_index=$((choice - 1))
                selected_sessions+=("${available_sessions[$selected_index]}")
                break
            else
                echo "❌ Invalid choice"
            fi
        done
    done

    # Create tmux session with 2x2 grid
    tmux kill-session -t "$session_name" 2>/dev/null
    tmux new-session -d -s "$session_name" -c "$PWD"
    tmux split-window -v -t "$session_name:0"
    tmux split-window -h -t "$session_name:0.0"
    tmux split-window -h -t "$session_name:0.1"

    # Set up each pane
    local pane_colors=('\033[31m' '\033[32m' '\033[34m' '\033[35m')
    for i in {0..3}; do
        IFS='|' read -r session_id filepath display_name <<< "${selected_sessions[$i]}"
        local color="${pane_colors[$i]}"

        # Create formatter for this pane
        cat > "./quad-formatter-$i.sh" << EOF
#!/bin/bash
COLOR='$color'
DISPLAY_NAME='$display_name'
RESET='\033[0m'
BOLD='\033[1m'

echo -e "\${COLOR}\${BOLD}╔═══ \$DISPLAY_NAME ═══╗\${RESET}"

while IFS= read -r line; do
    [[ ! "\$line" =~ ^[[:space:]]*\\{ ]] && continue

    if command -v jq >/dev/null 2>&1; then
        timestamp=\$(echo "\$line" | jq -r '.timestamp // empty' 2>/dev/null)
        message_type=\$(echo "\$line" | jq -r '.type // empty' 2>/dev/null)
        time_display="\${timestamp:11:8}"

        case "\$message_type" in
            "user")
                content=\$(echo "\$line" | jq -r '.message.content[0].content // .message.content // empty' 2>/dev/null)
                if [[ "\$content" != "null" && -n "\$content" ]]; then
                    if [[ \${#content} -gt 45 ]]; then
                        content="\${content:0:42}..."
                    fi
                    echo -e "\${COLOR}┃\${RESET} [\$time_display] \${BOLD}USER:\${RESET} \$content"
                fi
                ;;
            "assistant")
                tool_name=\$(echo "\$line" | jq -r '.message.content[0].name // empty' 2>/dev/null)
                content=\$(echo "\$line" | jq -r '.message.content[0].text // empty' 2>/dev/null)

                if [[ "\$tool_name" != "null" && -n "\$tool_name" ]]; then
                    echo -e "\${COLOR}┃\${RESET} [\$time_display] \${COLOR}TOOL:\${RESET} \$tool_name"
                elif [[ "\$content" != "null" && -n "\$content" ]]; then
                    if [[ \${#content} -gt 45 ]]; then
                        content="\${content:0:42}..."
                    fi
                    echo -e "\${COLOR}┃\${RESET} [\$time_display] \${COLOR}ASST:\${RESET} \$content"
                fi
                ;;
        esac
    fi
done
EOF
        chmod +x "./quad-formatter-$i.sh"

        # Start monitoring in pane
        tmux send-keys -t "$session_name:0.$i" "tail -n 3 -f '$filepath' | ./quad-formatter-$i.sh" Enter
    done

    echo "✅ Quad pane monitor ready!"
    echo "🎮 Controls: Ctrl+b, ←↑↓→ to navigate panes"
    echo "🚪 Exit: Ctrl+b, x, y (kill session) or Ctrl+b, d (detach)"
    sleep 3

    # Cleanup formatters on exit
    cleanup_quad() {
        rm -f ./quad-formatter-*.sh
    }
    trap 'cleanup_quad' EXIT

    tmux attach-session -t "$session_name"
}

# Swarm consolidated monitoring
cmd_swarm() {
    if ! command -v inotifywait >/dev/null 2>&1; then
        echo "❌ inotifywait required: sudo apt-get install inotify-tools"
        exit 1
    fi

    echo "🐝 Swarm Monitor - Consolidated view of all active sessions"
    echo "📂 Directory: $CHAT_LOGS_DIR"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "💡 All sessions will appear as they become active"
    echo "🎨 Each session gets unique color/symbol combination"
    echo ""

    # Track active sessions with last activity times
    declare -A last_activity

    # Monitor all activity
    inotifywait -m -q --format '%w%f %e' -e modify "$CHAT_LOGS_DIR" | while read filepath event; do
        [[ "$filepath" =~ \.jsonl$ ]] || continue

        local session_id=$(basename "$filepath" .jsonl)
        local latest_line=$(tail -n 1 "$filepath" 2>/dev/null)
        [[ -z "$latest_line" ]] && continue

        # Update activity time
        last_activity[$session_id]=$(date +%s)

        # Display with swarm formatting
        display_log_entry "$session_id" "$latest_line" true
    done
}

# Grid monitoring for large swarms
cmd_grid() {
    if ! command -v tmux >/dev/null 2>&1; then
        echo "❌ tmux required: sudo apt-get install tmux"
        exit 1
    fi

    local grid_size="4x4"  # default
    local max_sessions=16

    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --size)
                grid_size="$2"
                case "$grid_size" in
                    3x3) max_sessions=9 ;;
                    4x4) max_sessions=16 ;;
                    5x3) max_sessions=15 ;;
                    6x3) max_sessions=18 ;;
                    *) echo "❌ Unsupported grid size: $grid_size"; exit 1 ;;
                esac
                shift 2
                ;;
            -h|--help)
                echo "Usage: chat-monitor grid [options]"
                echo "Options:"
                echo "  --size SIZE    Grid size: 3x3, 4x4, 5x3, 6x3 (default: 4x4)"
                echo "  -h, --help     Show this help"
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    local session_name="chat-grid-${grid_size//x/-}"
    local available_sessions=($(get_recent_sessions))

    echo "🔲 Grid Monitor - $grid_size layout ($max_sessions sessions)"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if [[ ${#available_sessions[@]} -eq 0 ]]; then
        echo "🔄 No active sessions. Monitoring for activity..."
        echo "💡 Sessions will auto-populate as they become active"
        # Could implement waiting logic here
        exit 0
    fi

    # Limit to grid capacity
    local sessions_to_use=()
    local count=0
    for session in "${available_sessions[@]}"; do
        if [[ $count -lt $max_sessions ]]; then
            sessions_to_use+=("$session")
            ((count++))
        fi
    done

    echo "📊 Setting up $grid_size grid with ${#sessions_to_use[@]} sessions"

    # Create tmux session
    tmux kill-session -t "$session_name" 2>/dev/null
    tmux new-session -d -s "$session_name" -c "$PWD"

    # Create grid layout based on size
    case "$grid_size" in
        3x3)
            # Create 3x3 grid (9 panes)
            tmux split-window -v -t "$session_name:0"
            tmux split-window -v -t "$session_name:0.1"
            tmux split-window -h -t "$session_name:0.0"
            tmux split-window -h -t "$session_name:0.2"
            tmux split-window -h -t "$session_name:0.3"
            tmux split-window -h -t "$session_name:0.1"
            tmux split-window -h -t "$session_name:0.4"
            tmux split-window -h -t "$session_name:0.6"
            ;;
        4x4)
            # Create 4x4 grid (16 panes)
            for i in {1..3}; do
                tmux split-window -v -t "$session_name:0"
            done
            for i in {0..3}; do
                for j in {1..3}; do
                    tmux split-window -h -t "$session_name:0.$i"
                done
            done
            ;;
        5x3|6x3)
            # Create rectangular grids
            local rows cols
            IFS='x' read -r cols rows <<< "$grid_size"

            # Create rows first
            for ((i=1; i<rows; i++)); do
                tmux split-window -v -t "$session_name:0"
            done

            # Create columns in each row
            for ((row=0; row<rows; row++)); do
                for ((col=1; col<cols; col++)); do
                    tmux split-window -h -t "$session_name:0.$row"
                done
            done
            ;;
    esac

    # Set up formatters and monitoring for each pane
    local pane_index=0
    for session_data in "${sessions_to_use[@]}"; do
        IFS='|' read -r session_id filepath display_name <<< "$session_data"

        # Create compact formatter for grid view
        cat > "./grid-formatter-$pane_index.sh" << EOF
#!/bin/bash
SESSION_ID='${session_id:0:6}'
COLOR='\033[3$((pane_index % 6 + 1))m'
RESET='\033[0m'
BOLD='\033[1m'

echo -e "\${COLOR}\${BOLD}[\$SESSION_ID]\${RESET}"

while IFS= read -r line; do
    [[ ! "\$line" =~ ^[[:space:]]*\\{ ]] && continue

    if command -v jq >/dev/null 2>&1; then
        timestamp=\$(echo "\$line" | jq -r '.timestamp // empty' 2>/dev/null)
        message_type=\$(echo "\$line" | jq -r '.type // empty' 2>/dev/null)
        time_display="\${timestamp:11:8}"

        case "\$message_type" in
            "user")
                content=\$(echo "\$line" | jq -r '.message.content[0].content // .message.content // empty' 2>/dev/null)
                if [[ "\$content" != "null" && -n "\$content" ]]; then
                    if [[ \${#content} -gt 25 ]]; then
                        content="\${content:0:22}..."
                    fi
                    echo -e "\${COLOR}U:\${RESET} \$content"
                fi
                ;;
            "assistant")
                tool_name=\$(echo "\$line" | jq -r '.message.content[0].name // empty' 2>/dev/null)
                if [[ "\$tool_name" != "null" && -n "\$tool_name" ]]; then
                    echo -e "\${COLOR}T:\${RESET} \$tool_name"
                else
                    content=\$(echo "\$line" | jq -r '.message.content[0].text // empty' 2>/dev/null)
                    if [[ "\$content" != "null" && -n "\$content" ]]; then
                        if [[ \${#content} -gt 25 ]]; then
                            content="\${content:0:22}..."
                        fi
                        echo -e "\${COLOR}A:\${RESET} \$content"
                    fi
                fi
                ;;
        esac
    fi
done
EOF
        chmod +x "./grid-formatter-$pane_index.sh"

        # Start monitoring in pane
        tmux send-keys -t "$session_name:0.$pane_index" "tail -n 2 -f '$filepath' | ./grid-formatter-$pane_index.sh" Enter

        ((pane_index++))
    done

    echo "✅ Grid monitor ready!"
    echo "🎮 Controls: Ctrl+b, ←↑↓→ to navigate panes"
    echo "🚪 Exit: Ctrl+b, x, y (kill) or ./chat-monitor cleanup"
    sleep 3

    # Cleanup on exit
    cleanup_grid() {
        rm -f ./grid-formatter-*.sh
    }
    trap 'cleanup_grid' EXIT

    tmux attach-session -t "$session_name"
}

