}

# Check requirements
check_requirements() {
    if [ ! -d "$CHAT_LOGS_DIR" ]; then
        echo "❌ Chat logs directory not found: $CHAT_LOGS_DIR"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "⚠️  jq not found. Install for better formatting: sudo apt-get install jq"
        sleep 1
    fi
}

# Main dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local subcommand="$1"
    shift

    check_requirements

    case "$subcommand" in
        basic)
            cmd_basic "$@"
            ;;
        lazy)
            cmd_lazy "$@"
            ;;
        interactive)
            cmd_interactive "$@"
            ;;
        triple-pane)
            cmd_triple_pane "$@"
            ;;
        quad-pane)
            cmd_quad_pane "$@"
            ;;
        -h|--help|help)
            show_help
            ;;
        swarm)
            cmd_swarm "$@"
            ;;
        grid)
            cmd_grid "$@"
            ;;
        cleanup|kill-all)
            echo "🧹 Cleaning up chat monitor processes..."
            tmux kill-session -t chat-triple-pane 2>/dev/null && echo "✅ Killed triple-pane session"
            tmux kill-session -t chat-quad-pane 2>/dev/null && echo "✅ Killed quad-pane session"
            tmux list-sessions | grep 'chat-grid-' | cut -d: -f1 | xargs -I {} tmux kill-session -t {} 2>/dev/null && echo "✅ Killed grid sessions"
            pkill -f "triple-formatter" 2>/dev/null && echo "✅ Killed triple formatters"
            pkill -f "quad-formatter" 2>/dev/null && echo "✅ Killed quad formatters"
            pkill -f "grid-formatter" 2>/dev/null && echo "✅ Killed grid formatters"
            pkill -f "inotifywait.*claude" 2>/dev/null && echo "✅ Killed chat monitors"
            rm -f ./triple-formatter-*.sh ./quad-formatter-*.sh ./grid-formatter-*.sh 2>/dev/null && echo "✅ Cleaned temp files"
            echo "✨ All chat monitor processes cleaned up"
            ;;
        *)
            echo "❌ Unknown subcommand: $subcommand"
            echo "Run '$SCRIPT_NAME --help' for available subcommands."
            exit 1
            ;;
    esac
}

main "$@"
