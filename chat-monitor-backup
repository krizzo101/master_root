#!/bin/bash

# Chat Monitor - Unified Claude Code session monitoring tool
# Usage: ./chat-monitor <subcommand> [options]

CHAT_LOGS_DIR="/home/opsvi/.claude/projects/-home-opsvi-master-root"
SCRIPT_NAME="chat-monitor"

# Global variables for session management
declare -A SESSION_COLOR_MAP
declare -A SESSION_SYMBOL_MAP
declare -A SESSION_NAMES
declare -A ACTIVE_SESSIONS
NEXT_COLOR_INDEX=0
VERBOSE_LEVEL=0  # 0=off, 1=basic, 2=detailed, 3=debug
VIEW_LOGGING_LEVEL=0  # 0=off, 1=messages only, 2=+metadata, 3=+raw JSON
VIEW_LOG_FILE="/tmp/chat-monitor-view.log"
VIEW_RAW_LOG_FILE="/tmp/chat-monitor-raw.log"

# Color and symbol palettes
SESSION_COLORS=(
    '\033[31m' '\033[32m' '\033[33m' '\033[34m' '\033[35m' '\033[36m'
    '\033[91m' '\033[92m' '\033[93m' '\033[94m' '\033[95m' '\033[96m'
    '\033[37m' '\033[90m' '\033[97m' '\033[30m'
)
SESSION_SYMBOLS=('●' '◆' '▲' '◀' '▶' '▼' '♦' '♠' '♣' '♥' '★' '✦')

# ANSI Colors
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
CYAN='\033[36m'
WHITE='\033[37m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Assign unique color/symbol to session
assign_session_style() {
    local session_id="$1"

    if [[ -z "${SESSION_COLOR_MAP[$session_id]}" ]]; then
        SESSION_COLOR_MAP[$session_id]="${SESSION_COLORS[$NEXT_COLOR_INDEX]}"
        SESSION_SYMBOL_MAP[$session_id]="${SESSION_SYMBOLS[$NEXT_COLOR_INDEX]}"
        NEXT_COLOR_INDEX=$(((NEXT_COLOR_INDEX + 1) % ${#SESSION_COLORS[@]}))
    fi
}

# Enhanced verbose logging with levels
verbose_log() {
    local level=${1:-1}  # Default to level 1
    shift
    [[ $VERBOSE_LEVEL -lt $level ]] && return

    local level_names=("" "INFO" "DETAIL" "DEBUG")
    local level_colors=("" "${GREEN}" "${CYAN}" "${MAGENTA}")
    local level_name="${level_names[$level]}"
    local level_color="${level_colors[$level]}"

    echo -e "${DIM}[${level_color}${level_name}${RESET}${DIM} $(date '+%H:%M:%S')] $*${RESET}" >&2
}

# Enhanced view logging with levels
log_view_output() {
    local level=${1:-1}  # Default to level 1 (messages only)
    shift
    [[ $VIEW_LOGGING_LEVEL -lt $level ]] && return

    case $level in
        1) # Messages only
            echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" >> "$VIEW_LOG_FILE"
            ;;
        2) # Messages + metadata
            echo "$(date '+%Y-%m-%d %H:%M:%S') | [L$level] $*" >> "$VIEW_LOG_FILE"
            ;;
        3) # Raw JSON logging
            echo "$(date '+%Y-%m-%d %H:%M:%S') | [RAW] $*" >> "$VIEW_RAW_LOG_FILE"
            ;;
    esac
}

# Display current logging status
show_logging_status() {
    local verbose_desc=("OFF" "BASIC" "DETAILED" "DEBUG")
    local view_desc=("OFF" "MESSAGES" "+METADATA" "+RAW_JSON")
    echo -e "${DIM}[STATUS] Verbose: ${verbose_desc[$VERBOSE_LEVEL]} | View Logging: ${view_desc[$VIEW_LOGGING_LEVEL]}${RESET}"
}

# Format and display log entry
display_log_entry() {
    local session_id="$1"
    local line="$2"
    local show_session="${3:-true}"

    # Skip non-JSON lines
    [[ ! "$line" =~ ^[[:space:]]*\{ ]] && return
    [[ "$line" =~ ^=\>.*\<==$ ]] && return

    verbose_log 1 "Processing log entry for session $session_id"
    verbose_log 3 "Raw JSON line: $line"

    if command -v jq >/dev/null 2>&1; then
        local timestamp=$(echo "$line" | jq -r '.timestamp // empty' 2>/dev/null)
        local message_type=$(echo "$line" | jq -r '.type // empty' 2>/dev/null)
        local time_display="${timestamp:11:8}"

        verbose_log 2 "Parsed: timestamp=$timestamp, type=$message_type"

        # Log raw JSON if level 3 view logging enabled
        log_view_output 3 "$line"

        # Assign session style
        assign_session_style "$session_id"
        local session_color="${SESSION_COLOR_MAP[$session_id]}"
        local session_symbol="${SESSION_SYMBOL_MAP[$session_id]}"

        verbose_log 2 "Session style: color=${session_color}, symbol=${session_symbol}"

        local session_prefix=""
        if [[ "$show_session" == "true" ]]; then
            session_prefix=" ${session_color}${session_symbol} ${session_id:0:8}${RESET}"
        fi

        case "$message_type" in
            "user")
                local content=$(echo "$line" | jq -r '.message.content[0].content // .message.content // empty' 2>/dev/null)
                if [[ "$content" != "null" && -n "$content" ]]; then
                    local original_length=${#content}
                    if [[ ${#content} -gt 80 ]]; then
                        content="${content:0:77}..."
                    fi
                    local output="${DIM}[$time_display]${RESET}$session_prefix ${session_color}USER:${RESET} $content"
                    echo -e "$output"
                    log_view_output 1 "USER [$session_id] $content"
                    log_view_output 2 "USER [$session_id] chars:$original_length truncated:$([ $original_length -gt 80 ] && echo "YES" || echo "NO") | $content"
                    verbose_log 1 "Displayed USER message from session $session_id: $original_length chars"
                    verbose_log 2 "USER content preview: ${content:0:50}..."
                fi
                ;;
            "assistant")
                local tool_name=$(echo "$line" | jq -r '.message.content[0].name // empty' 2>/dev/null)
                local content=$(echo "$line" | jq -r '.message.content[0].text // empty' 2>/dev/null)

                if [[ "$tool_name" != "null" && -n "$tool_name" ]]; then
                    # Extract tool parameters for detailed logging
                    local tool_params=$(echo "$line" | jq -r '.message.content[0].input // empty' 2>/dev/null)
                    local tool_output="${DIM}[$time_display]${RESET}$session_prefix ${session_color}TOOL:${RESET} $tool_name"
                    echo -e "$tool_output"
                    log_view_output 1 "TOOL [$session_id] $tool_name"
                    log_view_output 2 "TOOL [$session_id] name:$tool_name params:${tool_params:0:100}..."
                    verbose_log 1 "Displayed TOOL usage from session $session_id: $tool_name"
                    verbose_log 2 "TOOL parameters preview: ${tool_params:0:100}..."
                elif [[ "$content" != "null" && -n "$content" ]]; then
                    local original_length=${#content}
                    if [[ ${#content} -gt 80 ]]; then
                        content="${content:0:77}..."
                    fi
                    local asst_output="${DIM}[$time_display]${RESET}$session_prefix ${session_color}ASST:${RESET} $content"
                    echo -e "$asst_output"
                    log_view_output 1 "ASST [$session_id] $content"
                    log_view_output 2 "ASST [$session_id] chars:$original_length truncated:$([ $original_length -gt 80 ] && echo "YES" || echo "NO") | $content"
                    verbose_log 1 "Displayed ASST message from session $session_id: $original_length chars"
                    verbose_log 2 "ASST content preview: ${content:0:50}..."
                fi
                ;;
        esac
    else
        echo -e "${DIM}Activity in $session_id${RESET}"
    fi
}

# Get recent sessions for selection
get_recent_sessions() {
    local sessions=()
    local current_time=$(date +%s)

    while IFS= read -r -d '' filepath; do
        local last_modified=$(stat -c %Y "$filepath" 2>/dev/null || echo 0)
        local age=$((current_time - last_modified))

        if [[ $age -lt 14400 ]]; then  # 4 hours
            local session_id=$(basename "$filepath" .jsonl)

            # Get latest summary from session
            local summary=$(jq -r 'select(.type=="summary") | .summary' "$filepath" 2>/dev/null | tail -1)
            if [[ -z "$summary" || "$summary" == "null" ]]; then
                summary="No summary available"
            fi

            # Truncate summary if too long
            if [[ ${#summary} -gt 50 ]]; then
                summary="${summary:0:47}..."
            fi

            # Get branch info
            local branch=$(tail -n 3 "$filepath" 2>/dev/null | jq -r 'select(.gitBranch) | .gitBranch' 2>/dev/null | tail -n 1 || echo "")

            local display_name="${session_id:0:8}: $summary"
            [[ -n "$branch" ]] && display_name="$display_name [$branch]"

            sessions+=("$session_id|$filepath|$display_name")
        fi
    done < <(find "$CHAT_LOGS_DIR" -name "*.jsonl" -type f -print0)

    printf '%s\n' "${sessions[@]}" | sort -t'|' -k3
}

# Interactive session selector
select_session() {
    local available_sessions=($(get_recent_sessions))

    echo "🎯 Session Selector"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if [[ ${#available_sessions[@]} -eq 0 ]]; then
        echo "❌ No recent sessions found"
        exit 1
    fi

    echo "📋 Available sessions:"
    for i in "${!available_sessions[@]}"; do
        IFS='|' read -r session_id filepath display_name <<< "${available_sessions[$i]}"
        echo "  $((i+1)). $display_name"
    done
    echo ""

    while true; do
        echo -n "🎯 Select session (1-${#available_sessions[@]}): "
        read -r choice

        if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -le ${#available_sessions[@]} ]]; then
            local selected_index=$((choice - 1))
            IFS='|' read -r session_id filepath display_name <<< "${available_sessions[$selected_index]}"
            echo "$session_id"
            return 0
        else
            echo "❌ Invalid choice. Please enter a number between 1 and ${#available_sessions[@]}"
        fi
    done
}

